  "name": "fluorescence polarization immunoassay",
  "preferredOntologyIdentifier": "http://id.nlm.nih.gov/mesh/2018/M0024787",
  "synonym": [
    "FPIA",
    "polarization fluoroimmunoassay"
  ]
